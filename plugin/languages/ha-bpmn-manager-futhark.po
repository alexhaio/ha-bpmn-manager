msgstr "Enable standard WordPress tags (post_tag) for granular labeling, searchability, and keyword filtering of your BPMN processes."

msgid "Revision History & Version Comparison"
msgstr "Revision History & Version Comparison"

msgid "Pro Feature"
msgstr "Pro Feature"

msgid "Tracks diagram version history on every save. Enables the \"History\" studio button with visual semantic comparison (added, modified, deleted BPMN elements) and one-click rollback."
msgstr "Tracks diagram version history on every save. Enables the \"History\" studio button with visual semantic comparison (added, modified, deleted BPMN elements) and one-click rollback."

msgid "BPMN Studio & Modeler Modules"
msgstr "BPMN Studio & Modeler Modules"

msgid "Turn editor features on or off depending on your team workflow and performance preferences."
msgstr "Turn editor features on or off depending on your team workflow and performance preferences."

msgid "Interactive Token Simulation"
msgstr "Interactive Token Simulation"

msgid "Provides dynamic token playback in the editor with play/pause, step controls, and speed regulator to test process flow logic interactively."
msgstr "Provides dynamic token playback in the editor with play/pause, step controls, and speed regulator to test process flow logic interactively."

msgid "Minimap Navigation"
msgstr "Minimap Navigation"

msgid "Shows a high-level mini-overview map in the top-right corner of the canvas with a collapsible toggle button for fast navigation across large workflows."
msgstr "Shows a high-level mini-overview map in the top-right corner of the canvas with a collapsible toggle button for fast navigation across large workflows."

msgid "Real-time BPMN 2.0 Linter"
msgstr "Real-time BPMN 2.0 Linter"

msgid "Validates diagrams in real time against BPMN 2.0 best practices (unconnected elements, missing end events, invalid flows) and displays unobtrusive guidance."
msgstr "Validates diagrams in real time against BPMN 2.0 best practices (unconnected elements, missing end events, invalid flows) and displays unobtrusive guidance."

msgid "Camunda Properties Panel"
msgstr "Camunda Properties Panel"

msgid "Enables the collapsible right sidebar in the editor to inspect and configure element IDs, names, documentation, and technical execution properties."
msgstr "Enables the collapsible right sidebar in the editor to inspect and configure element IDs, names, documentation, and technical execution properties."

msgid "Interactive Guide & BPMN-Quest (Tutorial)"
msgstr "Interactive Guide & BPMN-Quest (Tutorial)"

msgid "Enables the interactive tutorial button, gamified learning companion HUD, step-by-step walkthroughs, and linter challenges in the BPMN editor."
msgstr "Enables the interactive tutorial button, gamified learning companion HUD, step-by-step walkthroughs, and linter challenges in the BPMN editor."

msgid "Process Templates Library"
msgstr "Process Templates Library"

msgid "Enables the pre-built business process templates modal and toolbar button (e.g. employee onboarding, invoice approval, change request) to quickly jump-start diagram modeling."
msgstr "Enables the pre-built business process templates modal and toolbar button (e.g. employee onboarding, invoice approval, change request) to quickly jump-start diagram modeling."

msgid "QM Process Handbook (Print/PDF)"
msgstr "QM Process Handbook (Print/PDF)"

